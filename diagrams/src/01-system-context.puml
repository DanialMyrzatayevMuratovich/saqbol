@startuml system-context
' SaqBol — System Context diagram (C4 level 1)
' Render: java -jar plantuml.jar -tsvg diagrams/src/*.puml -o ../export
!pragma layout smetana
!include <C4/C4_Context>

LAYOUT_TOP_DOWN()
title SaqBol — System Context (main 91862dc; device validation pending)

Person(user, "Mobile user", "Resident of Kazakhstan who receives SMS and calls in Kazakh / Russian; protects self or an elderly relative")
Person(admin, "Administrator / analyst", "Monitors detection quality, reviews flagged messages, registers model versions")
Person_Ext(fraudster, "Fraudster", "Sends scam SMS and makes social-engineering calls (fake bank, fake police, Kaspi, prizes, phishing links)")

System(saqbol, "SaqBol", "Checks SMS and call transcripts, explains verdicts, keeps number reputation. Kazakh / Russian detection quality is under evaluation.")

System_Ext(telecom, "Mobile network and phone OS", "Delivers SMS and calls; Android exposes SMS inbox and call-screening APIs, iOS does not")
System_Ext(stt, "OS speech recognition service", "Current app requests ru_RU; local or provider processing is not enforced. Kazakh STT is planned, not implemented.")
System_Ext(training, "Model training environment", "Local scikit-learn baseline; Google Colab XLM-RoBERTa fine-tuning is planned")
System_Ext(b2b, "Bank / mobile operator (future)", "Possible B2B integration through the public API — out of scope for this diploma")

Rel(fraudster, telecom, "Sends scam SMS / places calls")
Rel(telecom, user, "Delivers SMS and calls")
Rel(user, saqbol, "Checks SMS, enables guard, runs live call analysis, reports false alarms", "Mobile app, HTTPS / WSS")
Rel(admin, saqbol, "Views metrics, flagged messages, model versions", "Web dashboard, HTTPS")
Rel(saqbol, telecom, "Reads incoming SMS, screens incoming calls (Android, with permission)")
Rel(saqbol, stt, "Mobile app requests microphone recognition; receives final text. SaqBol backend receives text only.")
Rel(training, saqbol, "Provides trained model artifacts")
Rel_U(b2b, saqbol, "Checks texts / numbers", "REST API")

SHOW_LEGEND()
footer
  HTTPS / WSS are target transports; local demo uses HTTP / WS.
  Source-code integration does not establish a successful real-call test.
endfooter
@enduml
