@startuml data-model
' SaqBol — data model (PostgreSQL), generated by hand from
' saqbol-backend/internal/store/migrations/*.sql
!pragma layout smetana
hide circle
skinparam linetype ortho

title SaqBol — Data model (PostgreSQL)

entity users {
  * id : uuid <<PK>>
  --
  * phone : text <<unique>>
  name : text
  * locale : text = 'ru'
  * password_hash : text
  * role : user_role (user | admin)
  * created_at : timestamptz
}

entity messages {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  * channel : channel (sms | call)
  * raw_text : text
  source_number : text
  scam_probability : double
  verdict : verdict (safe | suspicious | scam)
  * created_at : timestamptz
}

entity detections {
  * id : uuid <<PK>>
  --
  * message_id : uuid <<FK>>
  model_version_id : uuid <<FK>>
  category_id : int <<FK>>
  * probability : double
  * triggers : jsonb
  * latency_ms : int
  * created_at : timestamptz
}

entity scam_categories {
  * id : serial <<PK>>
  --
  * name : text <<unique>>
  description : text
}

entity model_versions {
  * id : uuid <<PK>>
  --
  * name : text
  metrics : jsonb
  * trained_at : timestamptz
}

entity reports {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  * message_id : uuid <<FK>>
  * feedback : report_feedback (confirmed | false_positive)
  * created_at : timestamptz
}

entity numbers {
  * number : text <<PK>>
  --
  * reports_count : int
  * risk_score : double [0..1]
  last_reported : timestamptz
}

entity call_sessions {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  transcript : text
  max_probability : double
  * alert_triggered : boolean
  * started_at : timestamptz
  ended_at : timestamptz
}

users ||--o{ messages
users ||--o{ reports
users ||--o{ call_sessions
messages ||--o{ detections
messages ||--o{ reports
scam_categories |o--o{ detections
model_versions |o--o{ detections
numbers |o..o{ messages : source_number\n(logical link)
@enduml
