# Copy to .env (git-ignored) before running docker compose:  cp .env.example .env
# For ANY server reachable from outside, use strong unique secrets (openssl rand -hex 32).

POSTGRES_PASSWORD=saqbol
JWT_ACCESS_SECRET=dev_access_change_me
JWT_REFRESH_SECRET=dev_refresh_change_me

# Phone that is promoted to admin on startup (e.g. +77000000001). Leave empty for none.
ADMIN_PHONES=

# Published ports — override if these are already taken on the host.
BACKEND_PORT=8080
WEB_PORT=3000
ML_PORT=8000

# Bind addresses. Default exposes backend/web on all interfaces (needed for phone/remote
# access). Set to 127.0.0.1 to keep a service private and reach it only via an SSH tunnel.
BACKEND_BIND=0.0.0.0
WEB_BIND=0.0.0.0
ML_BIND=127.0.0.1

# For a remote server, set this to the URL the browser/phone will actually call:
# WEB_API_BASE_URL=http://<SERVER_IP>:8080
WEB_API_BASE_URL=http://localhost:8080
